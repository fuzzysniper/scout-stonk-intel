+test('original baseline guard and all20 focused tests execute unchanged at immutable installed972, with no database use',()=>{const p=fs.mkdtempSync('/tmp/preview-immutable-');try{execFileSync('git',['worktree','add','--quiet','--detach',p,BASE]);fs.symlinkSync(path.resolve('node_modules'),p+'/node_modules');fs.symlinkSync(path.resolve('ops/native-beta-output/toolchain/node_modules'),p+'/ops/native-beta-output/toolchain/node_modules');const env={...process.env};delete env.NODE_TEST_CONTEXT;const output=execFileSync(process.execPath,['--test','--test-reporter=tap','tests/native-beta-output/output.test.mjs','tests/native-beta-output/verify.test.mjs','tests/native-beta-output/upload.test.mjs','tests/native-beta-output/workflow.test.mjs','tests/native-beta-output/scope.test.mjs'],{cwd:p,env,stdio:['ignore','pipe','pipe'],timeout:120000}).toString();assert.match(output,/# tests 20\b/);assert.match(output,/# pass 20\b/);assert.match(output,/# fail 0\b/);assert.match(output,/# skipped 0\b/);}finally{execFileSync('git',['worktree','remove','--force',p],{stdio:'ignore'});}});
+test('scope catches runtime/SQL/security/publisher/branch/settings/additional-path tampering',()=>{const p=fs.mkdtempSync(path.join(os.tmpdir(),'preview-patch-tamper-'));try{execFileSync('git',['clone','--shared','--quiet','--no-checkout',process.cwd(),p]);execFileSync('git',['checkout','--quiet','--detach','HEAD'],{cwd:p});review(p);for(const f of ['lib/native-pilot/auth.ts','lib/native-pilot/engine.ts','lib/native-pilot/postgres/schema.sql','.github/workflows/native-pilot-admission.yml','ops/native-pilot-admission/publisher.mjs','ops/native-beta-output/policy.json','vercel.json']){const file=path.join(p,f),old=fs.readFileSync(file);fs.appendFileSync(file,'\nSYNTHETIC');assert.throws(()=>review(p,false));fs.writeFileSync(file,old);}fs.writeFileSync(path.join(p,'UNAPPROVED'),'SYNTHETIC');assert.throws(()=>review(p,false));}finally{fs.rmSync(p,{recursive:true,force:true});}});
