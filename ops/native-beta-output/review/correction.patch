+test('every API status/transport failure is categorized, bounded, TLS-pinned, GET-only, single-attempt and secret-safe',async t=>{for(const scenario of ['ok','401','403','404','429','503','redirect','type','link','encoding','oversize','chunks','incomplete','empty','json','utf8','tls-auth','tls-sni','tls-version','timeout','network']){
+ let requests=0,opts;const hook=t.mock.method(https,'request',(options,callback)=>{requests++;opts=options;const q=new EventEmitter();q.destroy=()=>{};q.end=()=>queueMicrotask(()=>{const s=new EventEmitter();s.authorized=scenario!=='tls-auth';s.servername=scenario==='tls-sni'?'wrong.test':'api.vercel.com';s.getProtocol=()=>scenario==='tls-version'?'TLSv1.1':'TLSv1.3';s.getPeerCertificate=()=>({subjectaltname:'DNS:api.vercel.com'});q.emit('socket',s);s.emit('secureConnect');if(['timeout','tls-auth','tls-sni','tls-version'].includes(scenario))return;if(scenario==='network'){q.emit('error',Error(MARKER));return;}const r=new EventEmitter();r.statusCode=/^\d+$/.test(scenario)?Number(scenario):scenario==='redirect'?307:200;r.headers={'content-type':scenario==='type'?'text/plain':'application/json',...(scenario==='link'?{link:MARKER}:{}),...(scenario==='encoding'?{'content-encoding':'gzip'}:{})};r.complete=scenario!=='incomplete';r.destroy=()=>{};callback(r);if(scenario==='chunks')for(let i=0;i<257;i++)r.emit('data',Buffer.from(' '));else if(scenario!=='empty')r.emit('data',scenario==='utf8'?Buffer.from([0xff]):Buffer.from(scenario==='oversize'?'x'.repeat(1048577):scenario==='json'?MARKER:JSON.stringify({body:MARKER})));r.emit('end');});return q;});
+ try{const p=paths(context()).project,read=getReader('api.vercel.com',TOKEN,new Set([p]));if(scenario==='ok')assert.equal((await read(p)).body,MARKER);else await assert.rejects(read(p),e=>{const x=reportFailure(e);assert.equal(x.check,'VC_PROJECT');const expected=/^\d+$/.test(scenario)||scenario==='redirect'?'http_status':({'type':'content_type','link':'pagination','encoding':'encoding','oversize':'response_bound','chunks':'response_bound','incomplete':'incomplete','empty':'incomplete','json':'json','utf8':'json','tls-auth':'tls','tls-sni':'tls','tls-version':'tls','timeout':'timeout','network':'network'})[scenario];assert.equal(x.reason,expected,scenario);if(expected==='http_status')assert.equal(x.httpStatus,opts&&scenario==='redirect'?307:Number(scenario));assert.doesNotMatch(JSON.stringify(x),new RegExp(MARKER+'|'+TOKEN));return true;});assert.equal(requests,1);assert.equal(opts.method,'GET');assert.equal(opts.servername,'api.vercel.com');assert.equal(opts.rejectUnauthorized,true);assert.equal(opts.minVersion,'TLSv1.2');assert.equal(opts.agent,false);assert.equal(opts.headers.authorization,'Bearer '+TOKEN);assert.ok(!('body'in opts));}finally{hook.mock.restore();}
+ }});
+test('missing/invalid token and unapproved path make zero API requests; no secret shape data is printed',async t=>{let calls=0;const hook=t.mock.method(https,'request',()=>{calls++;throw Error(MARKER)});try{for(const value of [undefined,'',MARKER+'\n'])assert.throws(()=>getReader('api.vercel.com',value,new Set()),e=>{assert.equal(reportFailure(e).check,'VC_TOKEN');assert.doesNotMatch(JSON.stringify(reportFailure(e)),new RegExp(MARKER));return true;});const read=getReader('api.vercel.com',TOKEN,new Set(['/fixed']));await assert.rejects(read('/arbitrary'),e=>reportFailure(e).check==='REQUEST_ALLOWED');assert.equal(calls,0);}finally{hook.mock.restore();}});
+test('unwired inspection has no CLI/upload/archive-key/POST entry; fixed reader is the only network capability',()=>{const root=path.resolve('ops/native-beta-output'),visited=new Set();function walk(file){if(visited.has(file))return;visited.add(file);const text=fs.readFileSync(file,'utf8');assert.doesNotMatch(text,/from ['"]node:child_process|from ['"][^'"]*(?:upload|build)\.mjs|import\(['"][^'"]*vercel|UNFARMD_NATIVE_BUILD_ARCHIVE_KEY/);for(const m of text.matchAll(/from ['"](.+?)['"]/g))if(m[1].startsWith('.'))walk(path.resolve(path.dirname(file),m[1]));}walk(path.join(root,'inspect-only.mjs'));const source=fs.readFileSync(path.join(root,'preflight.mjs'),'utf8');assert.equal((source.match(/https\.request\(/g)??[]).length,1);assert.match(source,/method:'GET'/);assert.doesNotMatch(source,/method:'(?:POST|PATCH|PUT|DELETE)'|execFileSync|\.deploy\(/);const inspector=fs.readFileSync(path.join(root,'inspect-only.mjs'),'utf8');assert.doesNotMatch(inspector,/process\.env|process\.argv|\.seal\(|\.open\(|\.restore\(|writeFile/);});
