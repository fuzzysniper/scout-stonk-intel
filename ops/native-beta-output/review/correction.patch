+ const container=path.join(root,'node_modules/@vercel/container/dist/index.js'),tar=JSON.parse(fs.readFileSync(path.join(root,'node_modules/tar/package.json')));assert.equal(tar.version,'7.5.11');const s=fs.readFileSync(container,'utf8');assert.equal((s.match(/import_tar\.extract\)/g)??[]).length,3);assert.match(s,/async function fetchPinnedArchive/);assert.match(s,/async function fetchBuildpackage/);assert.match(s,/downloadPinnedArchive/);const policy=fs.readFileSync('ops/native-beta-output/output.mjs','utf8');assert.match(policy,/\['nodejs24\.x','edge'\]\.includes\(c.runtime\)/);
