{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "scout-scheduler-staging",
  "main": "hosted-entry.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACTIVATION": "disabled",
    "APP_ID": "5310753",
    "INSTALLATION_ID": "171233795",
    "REPOSITORY_ID": "1415026436",
    "C2_ARMED": "false",
    "C2_GATE_DISABLED_ATTESTED": "false",
    "C2_APP_ACTOR_ID": "342326617",
    "C2_INSTANCE_ID": "UNAPPROVED",
    "C2_NOT_BEFORE": "UNAPPROVED",
    "C2_EXPIRES_AT": "UNAPPROVED"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SLOTS", "class_name": "SlotCoordinator" },
      { "name": "C2_ONCE", "class_name": "StageC2ProofOnce" }
    ]
  },
  "exports": {
    "SlotCoordinator": { "type": "durable-object", "storage": "sqlite" },
    "StageC2ProofOnce": { "type": "durable-object", "storage": "sqlite" },
    "StageC2AuthProof": { "type": "workflow", "name": "scout-stage-c2-auth-only" }
  }
}
